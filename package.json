{
  "name": "nk-laser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/200.html')\" && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:init": "wrangler d1 execute nk-laser-db --file=./d1-schema.sql --remote",
    "db:seed": "wrangler d1 execute nk-laser-db --file=./d1-seed.sql --remote",
    "db:seed:local": "wrangler d1 execute nk-laser-db --file=./d1-seed.sql --local",
    "db:sync": "wrangler d1 execute nk-laser-db --file=./d1-schema.sql --remote",
    "db:sync:local": "wrangler d1 execute nk-laser-db --file=./d1-schema.sql --local",
    "deploy:pages": "bash deploy-pages.sh",
    "deploy:worker": "bash deploy-worker.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
